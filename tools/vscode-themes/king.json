{
  "name": "king",
  "description": "The KING web app's original palette: colours headings, strings and comments too.",
  "regexFlags": "gm",
  "regexes": {
    "^(#{1,6} .*?)([ \\t]@[a-z0-9][a-z0-9-]*)?[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#FFFFFF",
          "fontWeight": "bold"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(@node)([ \\t]+)([a-z0-9][a-z0-9-]*)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(@node)([ \\t]+)([A-Z][A-Za-z0-9-]*)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#4EC9B0"
        }
      ]
    },
    "^(@link)([ \\t]+)(\\S+)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#A5ABB6"
        }
      ]
    },
    "^(- )(link)( +)([a-z0-9][a-z0-9-]*)(:)([^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#A5ABB6"
        },
        {
          "color": "#808080"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(- )(from)( .*? )(to)( [^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#C586C0"
        },
        {
          "color": "#E8D48A"
        },
        {
          "color": "#C586C0"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(- )(type)(:)( *[A-Z][A-Za-z0-9-]*)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#9CDCFE"
        },
        {
          "color": "#808080"
        },
        {
          "color": "#4EC9B0"
        }
      ]
    },
    "^(- )(inverse)(:)( *[a-z0-9][a-z0-9-]*)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#9CDCFE"
        },
        {
          "color": "#808080"
        },
        {
          "color": "#A5ABB6"
        }
      ]
    },
    "^(- )(label)(:)([^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#9CDCFE"
        },
        {
          "color": "#808080"
        },
        {
          "color": "#CE9178"
        }
      ]
    },
    "^(- )(?!link |from |type:|inverse:|label:)([A-Za-z_][\\w-]*)(:)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#9CDCFE"
        },
        {
          "color": "#808080"
        }
      ]
    },
    "^(kg|use|import)(:)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#9CDCFE"
        },
        {
          "color": "#808080"
        }
      ]
    },
    "(?<=[:(] *)(Concept|Group|Module|Example|Warning|Num|Str|Bool|None|List|Dict|Content)\\b": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#4EC9B0"
        }
      ]
    },
    "\"[^\"\\n]*\"|`[^`\\n]*`": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#CE9178"
        }
      ]
    },
    "(?<=^|\\s)(?<!//.*)@(?!(?:node|link|add|ask|block|print)\\b)[a-z0-9][a-z0-9-]*": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#E8D48A"
        }
      ]
    },
    "(?<=^(?:[^\"\\n]|\"[^\"\\n]*\")*)(?:^|(?<=\\s))//[^\\n]*": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#6A9955",
          "fontStyle": "italic"
        }
      ]
    },
    "^@(?:add|ask|block|print)\\b": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        }
      ]
    },
    "(?<=^@(?:add|ask)[ \\t]+)([A-Za-z_][\\w.-]*)([ \\t]*)(=)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#E8D48A"
        },
        {},
        {
          "color": "#A5ABB6"
        }
      ]
    },
    "(?<=^@(?:add|ask)[ \\t]+(?:(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]*=[ \\t]*)?)(?:(\"(?:[^\"\\\\n]|\\.)*\")|(-?\\d+(?:\\.\\d+)?)(?![\\w.-])|(true|false|none)(?![\\w.-])|(\\?[A-Za-z_][\\w-]*|_(?![\\w.-]))|([A-Za-z_][\\w.-]*))": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#CE9178"
        },
        {
          "color": "#CE9178"
        },
        {
          "color": "#CE9178"
        },
        {
          "color": "#4EC9B0"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "(?<=^@(?:add|ask)[ \\t]+(?:(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]*=[ \\t]*)?(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]+)(?:(\\?[A-Za-z_][\\w-]*|_(?![\\w.-]))|((?!//)[^\\s\\\"]+))": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#4EC9B0"
        },
        {
          "color": "#A5ABB6"
        }
      ]
    },
    "(?<=^@(?:add|ask)[ \\t]+(?:(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]*=[ \\t]*)?(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]+(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]+)(?:(\"(?:[^\"\\\\n]|\\.)*\")|(-?\\d+(?:\\.\\d+)?)(?![\\w.-])|(true|false|none)(?![\\w.-])|(\\?[A-Za-z_][\\w-]*|_(?![\\w.-]))|([A-Za-z_][\\w.-]*))": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#CE9178"
        },
        {
          "color": "#CE9178"
        },
        {
          "color": "#CE9178"
        },
        {
          "color": "#4EC9B0"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "(?<=^@(?:block|print)[ \\t]+)([A-Za-z_?][\\w.-]*)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#E8D48A"
        }
      ]
    },
    "(?<=^@(?:add|ask|block|print)\\b(?:[^\"/\\n]|/(?!/)|\"(?:[^\"\\\\n]|\\.)*\")*)//[^\\n]*": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#6A9955",
          "fontStyle": "italic"
        }
      ]
    }
  }
}