{
  "name": "king",
  "description": "Bảng màu gốc của KING web app: tô cả heading, chuỗi, comment.",
  "regexFlags": "gm",
  "regexes": {
    "^(#{1,6} .*?)([ \\t]@[a-z0-9][a-z0-9-]*)?[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#FFFFFF",
          "fontWeight": "bold"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(@node)([ \\t]+)([a-z0-9][a-z0-9-]*)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(@node)([ \\t]+)([A-Z][A-Za-z0-9-]*)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#4EC9B0"
        }
      ]
    },
    "^(@link)([ \\t]+)(\\S+)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#A5ABB6"
        }
      ]
    },
    "^(- )(link)( +)([a-z0-9][a-z0-9-]*)(:)([^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#A5ABB6"
        },
        {
          "color": "#808080"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(- )(from)( .*? )(to)( [^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#C586C0"
        },
        {
          "color": "#E8D48A"
        },
        {
          "color": "#C586C0"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(- )(type)(:)( *[A-Z][A-Za-z0-9-]*)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#9CDCFE"
        },
        {
          "color": "#808080"
        },
        {
          "color": "#4EC9B0"
        }
      ]
    },
    "^(- )(inverse)(:)( *[a-z0-9][a-z0-9-]*)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#9CDCFE"
        },
        {
          "color": "#808080"
        },
        {
          "color": "#A5ABB6"
        }
      ]
    },
    "^(- )(label)(:)([^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#9CDCFE"
        },
        {
          "color": "#808080"
        },
        {
          "color": "#CE9178"
        }
      ]
    },
    "^(- )(?!link |from |type:|inverse:|label:)([A-Za-z_][\\w-]*)(:)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#808080"
        },
        {
          "color": "#9CDCFE"
        },
        {
          "color": "#808080"
        }
      ]
    },
    "^(kg|use|import)(:)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#9CDCFE"
        },
        {
          "color": "#808080"
        }
      ]
    },
    "(?<=[:(] *)(Concept|Group|Module|Example|Warning|Num|Str|Bool|None|List|Dict|Content)\\b": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#4EC9B0"
        }
      ]
    },
    "\"[^\"\\n]*\"|`[^`\\n]*`": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#CE9178"
        }
      ]
    },
    "(?<=^|\\s)@(?!node\\b|link\\b)[a-z0-9][a-z0-9-]*": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#E8D48A"
        }
      ]
    },
    "(?:^|(?<=\\s))//[^\\n]*": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#6A9955",
          "fontStyle": "italic"
        }
      ]
    }
  }
}