{
  "name": "markdown",
  "description": "Tôn trọng màu Markdown: chỉ tô @node, @link, link và value; heading/content/code giữ màu Markdown.",
  "regexFlags": "gm",
  "regexes": {
    "^(@node)([ \\t]+)([a-z0-9][a-z0-9-]*)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#E8D48A",
          "fontWeight": "bold"
        }
      ]
    },
    "^(@node)([ \\t]+)([A-Z][A-Za-z0-9-]*)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#4EC9B0",
          "fontWeight": "bold"
        }
      ]
    },
    "^(@link)([ \\t]+)(\\S+)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#A5ABB6",
          "fontWeight": "bold"
        }
      ]
    },
    "^(- )(link)( +)([a-z0-9][a-z0-9-]*)(:)([^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {},
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#A5ABB6"
        },
        {},
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(- )(from)( .*? )(to)( [^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {},
        {
          "color": "#C586C0"
        },
        {
          "color": "#E8D48A"
        },
        {
          "color": "#C586C0"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(- )(type)(:)( *[A-Z][A-Za-z0-9-]*)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {},
        {},
        {},
        {
          "color": "#4EC9B0"
        }
      ]
    },
    "^(- )(?!link |from |type:)([A-Za-z_][\\w-]*)(:)( *[^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {},
        {},
        {},
        {
          "color": "#CE9178"
        }
      ]
    },
    "(?<=^|\\s)@(?!node\\b|link\\b)[a-z0-9][a-z0-9-]*": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#E8D48A"
        }
      ]
    }
  }
}