{
  "name": "markdown",
  "description": "Respects Markdown colours: only @node, @link, links and values are coloured; headings/content/code keep Markdown colours.",
  "regexFlags": "gm",
  "regexes": {
    "^(@node)([ \\t]+)([a-z0-9][a-z0-9-]*)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#E8D48A",
          "fontWeight": "bold"
        }
      ]
    },
    "^(@node)([ \\t]+)([A-Z][A-Za-z0-9-]*)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#4EC9B0",
          "fontWeight": "bold"
        }
      ]
    },
    "^(@link)([ \\t]+)(\\S+)[ \\t]*$": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#A5ABB6",
          "fontWeight": "bold"
        }
      ]
    },
    "^(- )(link)( +)([a-z0-9][a-z0-9-]*)(:)([^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {},
        {
          "color": "#C586C0"
        },
        {},
        {
          "color": "#A5ABB6"
        },
        {},
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(- )(from)( .*? )(to)( [^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {},
        {
          "color": "#C586C0"
        },
        {
          "color": "#E8D48A"
        },
        {
          "color": "#C586C0"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^(- )(type)(:)( *[A-Z][A-Za-z0-9-]*)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {},
        {},
        {},
        {
          "color": "#4EC9B0"
        }
      ]
    },
    "^(- )(?!link |from |type:)([A-Za-z_][\\w-]*)(:)( *[^\\n]*?)(?=\\s//|$)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {},
        {},
        {},
        {
          "color": "#CE9178"
        }
      ]
    },
    "(?<=^|\\s)(?<!//.*)@(?!(?:node|link|add|ask|block|print)\\b)[a-z0-9][a-z0-9-]*": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#E8D48A"
        }
      ]
    },
    "^@(?:add|ask|block|print)\\b": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#C586C0"
        }
      ]
    },
    "(?<=^@(?:add|ask)[ \\t]+)([A-Za-z_][\\w.-]*)([ \\t]*)(=)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#E8D48A"
        },
        {},
        {
          "color": "#A5ABB6"
        }
      ]
    },
    "(?<=^@(?:add|ask)[ \\t]+(?:(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]*=[ \\t]*)?)(?:(\"(?:[^\"\\\\n]|\\.)*\")|(-?\\d+(?:\\.\\d+)?)(?![\\w.-])|(true|false|none)(?![\\w.-])|(\\?[A-Za-z_][\\w-]*|_(?![\\w.-]))|([A-Za-z_][\\w.-]*))": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#CE9178"
        },
        {
          "color": "#CE9178"
        },
        {
          "color": "#CE9178"
        },
        {
          "color": "#4EC9B0"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "(?<=^@(?:add|ask)[ \\t]+(?:(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]*=[ \\t]*)?(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]+)(?:(\\?[A-Za-z_][\\w-]*|_(?![\\w.-]))|((?!//)[^\\s\\\"]+))": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#4EC9B0"
        },
        {
          "color": "#A5ABB6"
        }
      ]
    },
    "(?<=^@(?:add|ask)[ \\t]+(?:(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]*=[ \\t]*)?(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]+(?:\"(?:[^\"\\\\n]|\\.)*\"|(?!//)[^\\s\"]+)[ \\t]+)(?:(\"(?:[^\"\\\\n]|\\.)*\")|(-?\\d+(?:\\.\\d+)?)(?![\\w.-])|(true|false|none)(?![\\w.-])|(\\?[A-Za-z_][\\w-]*|_(?![\\w.-]))|([A-Za-z_][\\w.-]*))": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#CE9178"
        },
        {
          "color": "#CE9178"
        },
        {
          "color": "#CE9178"
        },
        {
          "color": "#4EC9B0"
        },
        {
          "color": "#E8D48A"
        }
      ]
    },
    "(?<=^@(?:block|print)[ \\t]+)([A-Za-z_?][\\w.-]*)": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#E8D48A"
        }
      ]
    },
    "(?<=^@(?:add|ask|block|print)\\b(?:[^\"/\\n]|/(?!/)|\"(?:[^\"\\\\n]|\\.)*\")*)//[^\\n]*": {
      "filterFileRegex": ".*\\.kg\\.md$",
      "decorations": [
        {
          "color": "#6A9955",
          "fontStyle": "italic"
        }
      ]
    }
  }
}